# 应用配置
APP_NAME=安置帮教智能台账系统
DEBUG=false
SECRET_KEY=请用python -c "import secrets;print(secrets.token_hex(32))"生成一个随机密钥
DATABASE_URL=sqlite:///./data.db

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# OCR
OCR_ENGINE=rapidocr
OCR_MAX_PAGES=10
OCR_SCALE=1.5
